{
  "name": "fields-cafe",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist/client", "binding": "ASSETS" },
  "d1_databases": [{"binding":"DB","database_name":"fields-cafe","database_id":"REPLACE_WITH_YOUR_DATABASE_ID","migrations_dir":"drizzle"}],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"fields-cafe-menus"}]
}
